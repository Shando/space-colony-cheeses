; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[GD-Sync]

version="0.7"
uniqueUsername=true
publicKey="c97528684565a172"
privateKey="59dbaba44a95aca2"
useSenderID=true

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Space Colony Cheeses"
run/main_scene="res://Menus/main_menu.tscn"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

GDSync="*res://addons/GD-Sync/MultiplayerClient.gd"
Globals="*res://Scripts/Singletons/Globals.gd"
TTS="*res://Scripts/Singletons/TTS.gd"
Messages="*res://Scripts/Singletons/Messages.gd"
Functions="*res://Scripts/Singletons/Functions.gd"
UniversalSettings="*uid://b6sy572h06xqn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Space Colony Cheeses"

[editor_plugins]

enabled=PackedStringArray("res://addons/GD-Sync/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/scene-library/plugin.cfg", "res://addons/universal_settings/plugin.cfg")

[global_group]

Board="Board"
Models="Models"
Other="Other"

