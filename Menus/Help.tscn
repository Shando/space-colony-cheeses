bbcode_enabled = true
text = "[b][font_size=24]Laboratory Modules[/font_size]
(Cheese & Sausage - # Allowed = 1 of each - Cost = $10 - Cash Produced = $4 - Energy Required = 1)[/b]
These generate $4 each turn through research into new flavours of Cheeses or Sausages, and will generate $ whether there is a functional [b]Portal[/b] or not."

[node name="PanelContainer4" type="PanelContainer" parent="PanelContainer/VBoxContainer/TabContainer/Modules IV/VBoxContainer" unique_id=1439205183]
