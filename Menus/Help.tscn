metadata/_tab_index = 9

[node name="RichTextLabel" type="RichTextLabel" parent="PanelContainer/VBoxContainer/TabContainer/Keyboard and Mouse" unique_id=365113286]
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("5_5vlgg")
bbcode_enabled = true
text = "[b][font_size=24]KEYBOARD and MOUSE[/font_size][/b]



[b]F1[/b] displays this [b]Help[/b] ([b]F1[/b] again to close).

[b]F2[/b] displays the [b]Options[/b] screen ([b]F2[/b] again to close).

[b]F3[/b] stops any current speech.

[b]F12[/b] can be used to quit the game.

[b]W, A, S, D[/b] move the camera [b]Forwards[/b], [b]Left[/b], [b]Backwards[/b] & [b]Right[/b].
[b]DOWN Arrow looks down[/b].
[b]UP Arrow looks up[/b].

The [b]Mouse Wheel[/b] increases and decreases the speed of movement of the camera.

Pressing the [b]RIGHT Mouse button[/b] whilst [b]moving the mouse[/b] rotates the camera around the up axis.

"
scroll_active = false

[node name="About and Credits" type="MarginContainer" parent="PanelContainer/VBoxContainer/TabContainer" unique_id=1709175437]
