bbcode_enabled = true
text = "[b][font_size=24]Storage Modules[/font_size]
(Butter, Cream, Ice Cream, Manure & Milk - # Allowed = 1 of each - Cost = $5 - Energy Required = 1)[/b]
These can store up to 10 units of [b]Butter[/b], [b]Cream[/b], [b]Ice Cream[/b], [b]Manure[/b] or [b]Milk[/b], which can be sold, along with the other commodities, at a [b]Portal[/b]. All commodity [b]Storage[/b] modules [b]must[/b] be adjacent to a [b]Processing Plant[/b].
[b]NB:[/b] at the end of each turn, any remaining stored commodities (except [b]Leather[/b] and [b]Manure[/b]) spoil and [b]must[/b] be discarded with the relevant inventory dropping to 0."

