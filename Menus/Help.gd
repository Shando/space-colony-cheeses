func _on_Button_pressed():
	$SFX.stream = Globals.sfx_click
	$SFX.play()

	if bPaused:
		bPaused = false
		$PanelContainer/VBoxContainer/PanelContainer/HBoxContainer/Button.text = "PAUSE"
	else:
		bPaused = true
		$PanelContainer/VBoxContainer/PanelContainer/HBoxContainer/Button.text = "SPEAK"

func callPause(iIn):
	bPausing = true
	await get_tree().create_timer(iIn).timeout
	bPausing = false

func callSpeak():
	if aTxt.size() > 0:
		if aTxt[iC] == "P5":
			callPause(0.5)
		elif aTxt[iC] == "P1":
			callPause(0.1)
		else:
			if not TTS.is_speaking():
				get_tree().get_root().get_node("TTS").speak(aTxt[iC])

		iC += 1

		if iC == aTxt.size():
			aTxt = []
			iC = -1
