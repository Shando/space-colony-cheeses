extends Control

var aTxt = []
var iC = 0
var bFirst = true
var bPausing = false
var bPaused = true

func _ready():
	$PanelContainer/VBoxContainer/TabContainer.current_tab = 0
	get_tree().set_auto_accept_quit(false)

func _notification(what):
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		if GDSync.is_active():
			if Globals.bStarted:
				GDSync.call_func(Globals.playerQuit, [Globals.iMyPN])

			GDSync.quit()
		else:
			get_tree().quit()

func _process(_delta):
	if not bPaused:
		if not bPausing and not TTS.is_speaking():
			if Globals.optVoice > 0:
				callSpeak()

func _on_VBoxContainer_draw():
	if bFirst:
		_on_TabContainer_tab_selected(0)
		bFirst = false

